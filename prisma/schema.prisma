generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  sessions Session[]
  password String
}

model Session {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Candidate {
  id    String  @id @default(uuid())
  name  String?
  ci    String? @unique
  email String? @unique

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  assessments Assessment[]
}

model Dimension {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  questions Question[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  careerDimensions CareerDimension[]
}

model Career {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  careerDimensions CareerDimension[]
  results          Result[]
  courses          CareerCourse[]
  knowledgeLinks   CareerKnowledgeLink[]
}

model Question {
  id          Int     @id @default(autoincrement())
  seedKey     String? @unique
  text        String
  description String?

  dimensionId Int
  dimension   Dimension @relation(fields: [dimensionId], references: [id])

  type    QuestionType     @default(SINGLE_CHOICE)
  kind    QuestionKind     @default(INTEREST)
  options QuestionOption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  answers   Answer[]
}

model QuestionOption {
  id           Int      @id @default(autoincrement())
  code         String?  @unique
  text         String
  value        Float
  conceptCodes String[] @default([])

  questionId Int
  question   Question @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now())
  answers   Answer[]
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
  TEXT
}

model CareerDimension {
  id Int @id @default(autoincrement())

  careerId    Int
  dimensionId Int
  weight      Float @default(1.0)

  career    Career    @relation(fields: [careerId], references: [id])
  dimension Dimension @relation(fields: [dimensionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Answer {
  id Int @id @default(autoincrement())

  questionId       Int
  questionOptionId Int?

  value Float?
  text  String?

  questionOption QuestionOption? @relation(fields: [questionOptionId], references: [id])
  question       Question        @relation(fields: [questionId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  assessmentId Int?
}

model Assessment {
  id Int @id @default(autoincrement())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  answers Answer[]
  results Result[]

  completedAt           DateTime?
  questionnaireVersion  String    @default("vocacional-v1")
  recommendationVersion String    @default("jev-choice-v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Result {
  id Int @id @default(autoincrement())

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  careerId Int
  career   Career @relation(fields: [careerId], references: [id])

  // score remains nullable only to preserve historical prototype records.
  score                 Float?
  jevProbability        Float?
  rank                  Int?
  coverage              Float?
  matchedConceptCodes   String[] @default([])
  evidence              Json?
  gaps                  String[] @default([])
  recommendationVersion String   @default("jev-choice-v1")
  description           String?

  createdAt DateTime @default(now())

  @@unique([assessmentId, careerId])
}

model KnowledgeConcept {
  id            Int                   @id @default(autoincrement())
  code          String                @unique
  label         String
  type          KnowledgeConceptType
  description   String?
  sourceName    String?
  sourceUrl     String?
  sourceVersion String?
  status        KnowledgeReviewStatus @default(PRELIMINARY)
  links         CareerKnowledgeLink[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([type, status])
}

model CareerKnowledgeLink {
  id            Int                   @id @default(autoincrement())
  careerId      Int
  conceptId     Int
  relevance     Float                 @default(1)
  rationale     String
  sourceName    String?
  sourceUrl     String?
  sourceVersion String?
  status        KnowledgeReviewStatus @default(PRELIMINARY)
  career        Career                @relation(fields: [careerId], references: [id], onDelete: Cascade)
  concept       KnowledgeConcept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([careerId, conceptId])
  @@index([careerId, status])
}

model CareerCourse {
  id            Int      @id @default(autoincrement())
  careerId      Int
  name          String
  semester      Int?
  code          String?
  conceptCodes  String[] @default([])
  sourceName    String
  sourceUrl     String
  sourceVersion String
  career        Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([careerId, name])
  @@index([careerId, semester])
}

enum QuestionKind {
  INTEREST
  SUBJECT
  STRENGTH
  WORK_STYLE
}

enum KnowledgeConceptType {
  SUBJECT
  INTEREST
  SKILL
  WORK_ACTIVITY
  WORK_STYLE
  WORK_CONTEXT
  WORK_FIELD
}

enum KnowledgeReviewStatus {
  PRELIMINARY
  REVIEWED
}
